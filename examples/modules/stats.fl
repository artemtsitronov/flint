# stats.fl -- a module that imports another module.
#
# the import at the top is why stats.fl can call area() without defining it.
# there is one global table for the whole program, so importing shapes.fl here
# puts every name shapes.fl defines into scope for this file, exactly as it
# would for any other file.
#
# the path is working-directory relative, so it is the same "shapes.fl" the
# main file imports, not a path relative to this file. see main.fl.

import "shapes.fl"

# total_area() is the module's interface. everything else here is an
# implementation detail, though again there is nothing enforcing that.
export fn total_area(shapes) {
    let total = 0
    let i = 0
    while i < len(shapes) {
        # `area` is not defined in this file. it came in with the import, and
        # it works on the tables the caller passed because the function and the
        # data agree on shape without either of them saying so.
        total += area(shapes[i])
        i += 1
    }
    return total
}

export fn largest(shapes) {
    let best = nil
    let best_area = 0
    let i = 0
    while i < len(shapes) {
        let a = area(shapes[i])
        # `a > best_area` rather than `if a`. zero is truthy in flint, so
        # testing the number directly would take the branch on the first
        # iteration whatever the areas were. see docs/values.md
        if a > best_area {
            best_area = a
            best = shapes[i]
        }
        i += 1
    }
    return best
}
