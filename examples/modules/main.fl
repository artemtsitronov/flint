# modules: a multi-file program.
#
# run it, from the directory that holds these files:
#
#     cd examples/modules && ../../flint main.fl
#
# the `cd` is not a detail. an import path is resolved against the *process*
# working directory, not against the file doing the importing, so the same
# script run from elsewhere will not find its modules. that is the sharpest
# edge in the module system and it is not fixed. see ../../docs/modules.md
#
# the three files are:
#
#     shapes.fl   the data and the functions
#     stats.fl    a second module, importing the first
#     main.fl     the entry point, imports both
#
# a module is just a file. there is no package manager, no namespace, no
# `module` keyword and no `require`. importing a file runs it, and everything
# it defines becomes a global that every other file can see.

# ---------------------------------------------------------------- shapes.fl

# the file this module provides. `export` is a convention for marking what
# you meant to publish -- it is not access control, and an unexported name is
# still reachable from an importing file.
export fn area(shape) {
    # a table is the record type. there are no classes and no structs.
    if shape.kind == "rect" {
        return shape.w * shape.h
    }
    if shape.kind == "circle" {
        return 3.14159 * shape.r * shape.r
    }
    return 0
}

export fn describe(shape) {
    return shape.kind + " with area " + str(area(shape))
}

# a private helper. nothing stops another file calling this, and that is fine;
# the name is just not advertised.
fn normalise(shape) {
    if not shape.wide {
        return false
    }
    return true
}

# ------------------------------------------------------------------ stats.fl

# a module importing another module. paths are still working-directory
# relative, so this is the same "shapes.fl" the main file uses.
import "shapes.fl"

# `area` is in scope from the import above. there is no prefix and no
# qualification, because there is only one global table.
export fn total_area(shapes) {
    let total = 0
    let i = 0
    while i < len(shapes) {
        total += area(shapes[i])
        i += 1
    }
    return total
}

# ------------------------------------------------------------------- main.fl

# two modules, and a name from each, in the same file with no ceremony.
import "shapes.fl"
import "stats.fl"

let shapes = [
    {kind: "rect", w: 3, h: 4},
    {kind: "circle", r: 1}
]

# describe() comes from shapes.fl, total_area() from stats.fl, and neither
# file knows which file the other one pulled in.
print(describe(shapes[0]))
print(describe(shapes[1]))
print("total: " + str(total_area(shapes)))

# `largest` is also from stats.fl. it uses `a > best_area` internally rather
# than `if a`, because 0 is truthy and testing the number would take the
# branch on the first iteration regardless of the areas.
let biggest = largest(shapes)
print("largest is a " + biggest.kind)

# the collision hazard, stated plainly: all files share one global table. if
# two modules both define `helper`, the second one to run wins, and the order
# depends on import order. this is why a large project needs a naming
# convention for module-level globals. there is no private and no namespace to
# fall back on.
print("shapes[0] also normalises: " + str(normalise(shapes[0])))

# const works across the boundary. a const is a property of the binding in the
# shared table, so an exported const is read-only for every file that imports
# it, and the check happens when the assignment runs -- not when this file was
# compiled, because the import had not happened yet at that point.
import "limits.fl"
print("limit is " + str(LIMIT))
print("clamp(500) is " + str(clamp(500)))
# LIMIT = 99    # error: cannot assign to constant 'LIMIT'
