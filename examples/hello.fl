# hello.fl -- the smallest complete program.
#
# run it:  ./flint examples/hello.fl
#
# every flint program is a sequence of statements, one per line, and `print`
# writes one value and a newline. there is no main function and no entry point
# ceremony: the file *is* the program.

print("hello, world")

# numbers are doubles, and an integral one prints without a decimal point
print(42)
print(3.5)

# arithmetic is the four you would expect, plus a modulo
print(2 + 3)
print(10 - 4)
print(6 * 7)
print(20 / 4)
print(20 % 3)

# `+` is the one overloaded operator: two numbers add, two strings join
print("flint" + " " + "is small")

# anything can be turned into a string
print(str(42) + " is a number")

# and told what it is
print(type(1))
print(type("s"))
print(type([1, 2]))
print(type({a: 1}))
print(type(nil))
print(type(true))
